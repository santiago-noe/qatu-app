API_BASE_URL=http://localhost:8080
NEXT_INTERNAL_PORT=3001
PORT=3000
WS_PATH=/ws

# Clave pública de Cloudflare Turnstile (registro y recuperación). Vacía en desarrollo: sin widget.
# Prueba: 1x00000000000000000000AA (pasa) · 2x00000000000000000000AB (falla).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Teselas del mapa (MapLibre). Por defecto, OpenStreetMap (con su atribución); en producción,
# un proveedor de teselas (docs/04). Formato {z}/{x}/{y}.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
